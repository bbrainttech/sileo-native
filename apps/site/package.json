{
  "name": "sileo-native-site",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "setup-skia-web public && expo start --web",
    "build": "setup-skia-web public && EXPO_PUBLIC_GITHUB_STARS=$(node scripts/stars.mjs) expo export --platform web --clear && node scripts/sitemap.mjs",
    "serve": "npx serve dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sileo-native": "workspace:*"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.43.2",
    "react-native-monorepo-config": "^0.4.0"
  }
}
